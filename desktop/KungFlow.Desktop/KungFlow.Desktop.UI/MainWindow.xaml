<Window x:Class="KungFlow.Desktop.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KungFlow"
        Width="980"
        Height="720"
        MinWidth="760"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon128.png"
        Background="#0F172A">
  <Window.Resources>
    <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#1E293B" Offset="0" />
      <GradientStop Color="#0F172A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DashboardBackground" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#1E293B" Offset="0" />
      <GradientStop Color="#0F172A" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.85" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.6" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#1B2638" />
      <Setter Property="Foreground" Value="#E2E8F0" />
    </Style>

    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="104" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="18">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="White" />
          <Setter Property="Background" Value="#253149" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="White" />
          <Setter Property="Background" Value="#1E293B" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="LogoutButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="82" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#475569" />
      <Setter Property="Background" Value="#253149" />
      <Setter Property="Foreground" Value="#E2E8F0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#7F1D1D" />
          <Setter Property="BorderBrush" Value="#F87171" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#991B1B" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.6" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SettingsMenuButton" TargetType="Button">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="Background" Value="#1B2638" />
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="White" />
          <Setter Property="Background" Value="#253149" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DarkMetricCard" TargetType="Border">
      <Setter Property="Background" Value="#243044" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,14,14" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="BorderBrush" Value="#D1D5DB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource AppBackground}">
    <Grid x:Name="LoginView" Margin="16">
      <StackPanel VerticalAlignment="Center">
        <Image Source="Assets/icon128.png"
               Width="72"
               Height="56"
               Stretch="Uniform"
               Margin="0,0,0,10" />

        <TextBlock Text="KungFlow Login"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6" />

        <TextBlock Text="Sign in to sync KungFlow metrics"
                   FontSize="13"
                   Foreground="#AFC0D4"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16" />

        <Border Background="#1B2638"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">
          <Border.Effect>
            <DropShadowEffect Color="#33000000" BlurRadius="14" ShadowDepth="4" Opacity="0.35" />
          </Border.Effect>

          <StackPanel>
            <TextBlock Text="Email"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#CBD5E1"
                       Margin="0,0,0,6" />
            <TextBox x:Name="EmailTextBox"
                     Margin="0,0,0,12" />

            <TextBlock Text="Password"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#CBD5E1"
                       Margin="0,0,0,6" />
            <PasswordBox x:Name="PasswordBox"
                         Margin="0,0,0,12" />

            <Button x:Name="LoginButton"
                    Content="Login"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,4,0,0"
                    Click="LoginButton_Click" />

            <Button x:Name="RegisterButton"
                    Content="Create account"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,8,0,0"
                    Click="ShowRegisterButton_Click" />

            <TextBlock x:Name="MessageTextBlock"
                       MinHeight="16"
                       FontSize="12"
                       TextAlignment="Center"
                       Margin="0,10,0,0" />

            <TextBlock Text="Requires the local KungFlow server on port 3000."
                       FontSize="12"
                       Foreground="#94A3B8"
                       TextAlignment="Center"
                       Margin="0,12,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Grid x:Name="RegisterView" Margin="16" Visibility="Collapsed">
      <StackPanel VerticalAlignment="Center">
        <Image Source="Assets/icon128.png"
               Width="72"
               Height="56"
               Stretch="Uniform"
               Margin="0,0,0,10" />

        <TextBlock Text="Create KungFlow Account"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,6" />

        <TextBlock Text="Register once, then use the desktop focus agent"
                   FontSize="13"
                   Foreground="#AFC0D4"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,16" />

        <Border Background="#1B2638"
                BorderBrush="#334155"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16">
          <Border.Effect>
            <DropShadowEffect Color="#33000000" BlurRadius="14" ShadowDepth="4" Opacity="0.35" />
          </Border.Effect>

          <StackPanel>
            <TextBlock Text="Username"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#CBD5E1"
                       Margin="0,0,0,6" />
            <TextBox x:Name="RegisterUsernameTextBox"
                     Text="demo-user"
                     Margin="0,0,0,12" />

            <TextBlock Text="Email"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#CBD5E1"
                       Margin="0,0,0,6" />
            <TextBox x:Name="RegisterEmailTextBox"
                     Text="user@example.com"
                     Margin="0,0,0,12" />

            <TextBlock Text="Password"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#CBD5E1"
                       Margin="0,0,0,6" />
            <PasswordBox x:Name="RegisterPasswordBox"
                         MaxLength="20"
                         Margin="0,0,0,12" />

            <Button x:Name="CreateAccountButton"
                    Content="Register"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,4,0,0"
                    Click="RegisterButton_Click" />

            <Button x:Name="BackToLoginButton"
                    Content="Back to login"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,8,0,0"
                    Click="BackToLoginButton_Click" />

            <TextBlock x:Name="RegisterMessageTextBlock"
                       MinHeight="16"
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Grid x:Name="LoggedInView" Visibility="Collapsed" Background="{StaticResource DashboardBackground}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="#0F172A"
              BorderBrush="#1E293B"
              BorderThickness="0,0,0,1"
              Padding="28,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Image Source="Assets/icon128.png"
                   Width="48"
                   Height="34"
                   Stretch="Uniform"
                   Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="KungFlow"
                         FontSize="16"
                         FontWeight="Bold"
                         Foreground="White" />
              <TextBlock x:Name="LoggedInEmailTextBlock"
                         FontSize="11"
                         Foreground="#94A3B8" />
            </StackPanel>
          </StackPanel>

          <Border Grid.Column="1"
                  Background="#1B2638"
                  CornerRadius="19"
                  Padding="4">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="StatusNavButton"
                      Content="Status"
                      Style="{StaticResource NavButton}"
                      Click="StatusNavButton_Click" />
              <Button x:Name="StatisticsNavButton"
                      Content="Statistics"
                      Style="{StaticResource NavButton}"
                      Click="StatisticsNavButton_Click" />
              <Button x:Name="SettingsNavButton"
                      Content="Settings"
                      Style="{StaticResource NavButton}"
                      Click="SettingsNavButton_Click" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <Button x:Name="PrivacyNavButton"
                    Content="Privacy Policy"
                    Style="{StaticResource LinkButton}"
                    Click="PrivacyNavButton_Click" />
            <Button x:Name="LogoutButton"
                    Style="{StaticResource LogoutButtonStyle}"
                    Margin="14,0,0,0"
                    Click="LogoutButton_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Logout" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <ScrollViewer x:Name="StatusPage"
                      VerticalScrollBarVisibility="Auto">
          <Grid MinHeight="560" Margin="32">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="620">
              <TextBlock Text="YOUR CURRENT STATE"
                         FontSize="12"
                         FontWeight="Bold"
                         Foreground="#7C8AA2"
                         TextAlignment="Center"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,12" />

              <Ellipse x:Name="StatusOrbEllipse"
                       Width="118"
                       Height="118"
                       Fill="#94A3B8"
                       Stroke="#E2E8F0"
                       StrokeThickness="12"
                       Margin="0,0,0,22" />

              <Border Background="#29344A"
                      BorderBrush="#475569"
                      BorderThickness="1"
                      CornerRadius="14"
                      Padding="12,6"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,18">
                <TextBlock x:Name="StatusBadgeTextBlock"
                           Text="Waiting"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#CBD5E1" />
              </Border>

              <TextBlock x:Name="StatusHeadlineTextBlock"
                         Text="KungFlow is waiting for activity data."
                         FontSize="28"
                         FontWeight="Bold"
                         Foreground="White"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12" />

              <TextBlock x:Name="StatusBodyTextBlock"
                         Text="After the desktop agent collects enough computer activity, the firewall will decide whether interruptions should pass through."
                         FontSize="15"
                         Foreground="#AFC0D4"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Margin="0,0,0,24" />

              <UniformGrid Columns="2" Width="560">
                <Border Background="#1B2638"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="Firewall action"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="Bold" />
                    <TextBlock x:Name="NotificationRecommendationTextBlock"
                               Text="-"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                  </StackPanel>
                </Border>

                <Border Background="#1B2638"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="10,0,0,0">
                  <StackPanel>
                    <TextBlock Text="Desktop protection"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="Bold" />
                    <TextBlock x:Name="LocalFocusModeTextBlock"
                               Text="Inactive"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                  </StackPanel>
                </Border>
              </UniformGrid>

              <Border x:Name="FirewallStatusSummaryBorder"
                      Background="#1B2638"
                      BorderBrush="#334155"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="16"
                      Width="560"
                      Margin="0,16,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Notification firewall"
                               Foreground="#94A3B8"
                               FontSize="12"
                               FontWeight="Bold" />
                    <TextBlock x:Name="FirewallStatusSummaryTextBlock"
                               Text="Firewall inactive - notifications can pass through"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,8,16,0" />
                    <TextBlock x:Name="FirewallStatusDetailTextBlock"
                               Text="Automatic protection"
                               Foreground="#AFC0D4"
                               TextWrapping="Wrap"
                               Margin="0,5,16,0" />
                    <Grid Margin="0,14,16,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Background="#172033"
                              BorderBrush="#334155"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="10"
                              Margin="0,0,8,0">
                        <StackPanel>
                          <TextBlock Text="Mode"
                                     Foreground="#94A3B8"
                                     FontSize="11"
                                     FontWeight="Bold" />
                          <TextBlock x:Name="FirewallStatusModeTextBlock"
                                     Text="Global"
                                     Foreground="White"
                                     FontWeight="Bold"
                                     TextWrapping="Wrap"
                                     Margin="0,5,0,0" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1"
                              Background="#172033"
                              BorderBrush="#334155"
                              BorderThickness="1"
                              CornerRadius="8"
                              Padding="10"
                              Margin="8,0,0,0">
                        <StackPanel>
                          <TextBlock Text="Protected apps"
                                     Foreground="#94A3B8"
                                     FontSize="11"
                                     FontWeight="Bold" />
                          <TextBlock x:Name="FirewallStatusProtectedAppsTextBlock"
                                     Text="All notifications"
                                     Foreground="White"
                                     FontWeight="Bold"
                                     TextWrapping="Wrap"
                                     Margin="0,5,0,0" />
                        </StackPanel>
                      </Border>
                    </Grid>
                  </StackPanel>
                  <Border x:Name="FirewallStatusSourceBadgeBorder"
                          Grid.Column="1"
                          Background="#29344A"
                          BorderBrush="#475569"
                          BorderThickness="1"
                          CornerRadius="14"
                          Padding="10,5"
                          VerticalAlignment="Center">
                    <TextBlock x:Name="FirewallStatusSourceTextBlock"
                               Text="Automatic"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#CBD5E1" />
                  </Border>
                </Grid>
              </Border>

              <TextBlock x:Name="DesktopStatusMessageTextBlock"
                         MinHeight="20"
                         FontSize="12"
                         Foreground="#94A3B8"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         Margin="0,18,0,0" />
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="StatisticsPage"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
          <StackPanel Margin="40,34,40,40">
            <TextBlock Text="STATISTICS"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#7C8AA2"
                       Margin="0,0,0,8" />
            <TextBlock Text="Your Work Rhythm"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,6" />
            <TextBlock Text="A detailed look at the activity signals KungFlow tracks to understand cognitive load."
                       FontSize="14"
                       Foreground="#AFC0D4"
                       TextWrapping="Wrap"
                       Margin="0,0,0,28" />

            <Border Background="#1B2638"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="Current activity window"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,4" />
                <TextBlock Text="Signals collected from the current desktop activity window."
                           Foreground="#AFC0D4"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />
                <UniformGrid Columns="3">
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Open windows" Foreground="#94A3B8" />
                      <TextBlock x:Name="CurrentOpenWindowsTextBlock" Text="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,16,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Window switches" Foreground="#94A3B8" />
                      <TextBlock x:Name="CurrentWindowSwitchesTextBlock" Text="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,16,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Key presses" Foreground="#94A3B8" />
                      <TextBlock x:Name="CurrentKeyPressesTextBlock" Text="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,16,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Delete/Backspace" Foreground="#94A3B8" />
                      <TextBlock x:Name="CurrentDeleteKeyTextBlock" Text="0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,16,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Typing speed" Foreground="#94A3B8" />
                      <TextBlock x:Name="CurrentTypingSpeedTextBlock" Text="0.0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,16,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Mouse speed" Foreground="#94A3B8" />
                      <TextBlock x:Name="CurrentMouseSpeedTextBlock" Text="0.0" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,16,0,0" />
                    </StackPanel>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>

            <Border Background="#1B2638"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,0,0,18">
              <StackPanel>
                <TextBlock Text="Cognitive load model"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,4" />
                <TextBlock Text="How KungFlow interprets the latest activity compared with your personal baseline."
                           Foreground="#AFC0D4"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />
                <UniformGrid Columns="4">
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Load state" Foreground="#94A3B8" />
                      <TextBlock x:Name="LoadStateTextBlock" Text="Waiting" FontSize="16" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Score" Foreground="#94A3B8" />
                      <TextBlock x:Name="ScoreTextBlock" Text="-" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,12,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Baseline" Foreground="#94A3B8" />
                      <TextBlock x:Name="BaselineTextBlock" Text="-" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,12,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Baseline progress" Foreground="#94A3B8" />
                      <TextBlock x:Name="BaselineProgressTextBlock" Text="-" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,12,0,0" />
                      <TextBlock x:Name="LastStatusUpdateTextBlock" Text="Never" Foreground="#94A3B8" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </Border>

            <Border Background="#243044"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18"
                    Margin="0,10,0,0">
              <StackPanel>
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Firewall history"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="A short history of when KungFlow protected your focus."
                               Foreground="#AFC0D4"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                  </StackPanel>
                  <Button x:Name="RefreshFirewallHistoryButton"
                          Grid.Column="1"
                          Content="Refresh"
                          Style="{StaticResource SecondaryButton}"
                          Width="110"
                          Margin="16,0,0,0"
                          Click="RefreshFirewallHistoryButton_Click" />
                </Grid>

                <UniformGrid Columns="4" Margin="0,0,0,14">
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Activations today" Foreground="#94A3B8" />
                      <TextBlock x:Name="FirewallActivationsTodayTextBlock"
                                 Text="0"
                                 FontSize="28"
                                 FontWeight="Bold"
                                 Foreground="White"
                                 Margin="0,12,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Protected today" Foreground="#94A3B8" />
                      <TextBlock x:Name="FirewallProtectedTodayTextBlock"
                                 Text="0 min"
                                 FontSize="24"
                                 FontWeight="Bold"
                                 Foreground="White"
                                 TextWrapping="Wrap"
                                 Margin="0,12,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Latest action" Foreground="#94A3B8" />
                      <TextBlock x:Name="FirewallLatestActionTextBlock"
                                 Text="No events yet"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="White"
                                 TextWrapping="Wrap"
                                 Margin="0,12,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource DarkMetricCard}">
                    <StackPanel>
                      <TextBlock Text="Current source" Foreground="#94A3B8" />
                      <TextBlock x:Name="FirewallLatestControlModeTextBlock"
                                 Text="-"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 Foreground="White"
                                 TextWrapping="Wrap"
                                 Margin="0,12,0,0" />
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <TextBlock Text="Recent firewall events (latest 10)"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,8" />
                <StackPanel x:Name="RecentFirewallEventsPanel" />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsPage"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
          <StackPanel Margin="40,34,40,40">
            <TextBlock Text="SETTINGS"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#7C8AA2"
                       Margin="0,0,0,8" />
            <TextBlock Text="Settings"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,6" />
            <TextBlock Text="Manage activity collection, account security, and notification firewall behavior from one place."
                       FontSize="14"
                       Foreground="#AFC0D4"
                       TextWrapping="Wrap"
                       Margin="0,0,0,28" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Background="#172033"
                      BorderBrush="#334155"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="10"
                      VerticalAlignment="Top">
                <StackPanel>
                  <Button x:Name="ActivityCollectionSettingsButton"
                          Content="Activity collection"
                          Style="{StaticResource SettingsMenuButton}"
                          Click="ActivityCollectionSettingsButton_Click" />
                  <Button x:Name="AccountSecuritySettingsButton"
                          Content="Change password"
                          Style="{StaticResource SettingsMenuButton}"
                          Click="AccountSecuritySettingsButton_Click" />
                  <Button x:Name="FirewallControlSettingsButton"
                          Content="Firewall control"
                          Style="{StaticResource SettingsMenuButton}"
                          Margin="0"
                          Click="FirewallControlSettingsButton_Click" />
                </StackPanel>
              </Border>

              <Grid Grid.Column="2">
                <Border x:Name="ActivityCollectionSettingsPanel"
                        Background="#243044"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22">
                  <StackPanel>
                    <TextBlock Text="Activity collection"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Control whether KungFlow collects desktop activity signals for cognitive-load detection."
                               Foreground="#AFC0D4"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />
                    <CheckBox x:Name="DataCollectionEnabledCheckBox"
                              Content="Enable desktop activity collection"
                              IsChecked="True"
                              Foreground="White"
                              FontWeight="Bold"
                              Checked="DataCollectionEnabledCheckBox_Changed"
                              Unchecked="DataCollectionEnabledCheckBox_Changed" />
                    <TextBlock Text="When disabled, KungFlow stops polling and sending desktop activity until you enable it again."
                               Foreground="#AFC0D4"
                               TextWrapping="Wrap"
                               Margin="22,8,0,0" />
                  </StackPanel>
                </Border>

                <Border x:Name="AccountSecuritySettingsPanel"
                        Background="#243044"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22"
                        Visibility="Collapsed">
                  <StackPanel MaxWidth="520"
                              HorizontalAlignment="Left">
                    <TextBlock Text="Change password"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Change your KungFlow password. Passwords must be 6-20 characters and use English letters and numbers only."
                               Foreground="#AFC0D4"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18" />

                    <TextBlock Text="Current password"
                               Foreground="#CBD5E1"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="CurrentPasswordBox"
                                 Margin="0,0,0,12" />

                    <TextBlock Text="New password"
                               Foreground="#CBD5E1"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="NewPasswordBox"
                                 MaxLength="20"
                                 Margin="0,0,0,12" />

                    <TextBlock Text="Confirm new password"
                               Foreground="#CBD5E1"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="ConfirmNewPasswordBox"
                                 MaxLength="20"
                                 Margin="0,0,0,16" />

                    <Button x:Name="ChangePasswordButton"
                            Content="Change password"
                            Style="{StaticResource PrimaryButton}"
                            Width="180"
                            HorizontalAlignment="Left"
                            Click="ChangePasswordButton_Click" />
                    <TextBlock x:Name="ChangePasswordMessageTextBlock"
                               MinHeight="20"
                               Foreground="#AFC0D4"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                  </StackPanel>
                </Border>

                <Border x:Name="FirewallControlSettingsPanel"
                        Background="#243044"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="22"
                        Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock Text="Firewall control"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Use this to manually activate or deactivate the KungFlow Firewall. Global mode turns off all Windows notifications; selective mode targets specific app notification settings when Windows exposes them."
                               Foreground="#AFC0D4"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="ToggleNotificationsButton"
                              Content="Activate firewall"
                              Style="{StaticResource PrimaryButton}"
                              Width="230"
                              HorizontalAlignment="Left"
                              Click="ToggleNotificationsButton_Click" />
                      <Button x:Name="ResumeAutomaticControlButton"
                              Content="Resume automatic control"
                              Style="{StaticResource SecondaryButton}"
                              Width="220"
                              Margin="12,0,0,0"
                              HorizontalAlignment="Left"
                              Click="ResumeAutomaticControlButton_Click" />
                    </StackPanel>
                     <TextBlock x:Name="ManualNotificationStatusTextBlock"
                                Text="Firewall is inactive"
                                Foreground="#AFC0D4"
                                FontWeight="Bold"
                                Margin="0,10,0,22" />

                    <TextBlock Text="Firewall mode"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <RadioButton x:Name="GlobalFirewallModeRadioButton"
                                   GroupName="FirewallMode"
                                   Foreground="#E2E8F0"
                                   FontWeight="Bold"
                                   HorizontalContentAlignment="Stretch"
                                   Checked="FirewallModeRadioButton_Checked">
                        <RadioButton.Content>
                          <Border Background="#172033"
                                  BorderBrush="#334155"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Padding="12"
                                  Margin="8,0,10,0">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Width="38"
                                      Height="38"
                                      CornerRadius="19"
                                      Background="#1D4ED8"
                                      Margin="0,0,12,0">
                                <Viewbox Width="21"
                                         Height="21"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                  <Canvas Width="24" Height="24">
                                    <Path Stroke="White"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M12 3 C9.2 3 7 5.2 7 8 L7 11.2 C7 12.5 6.5 13.7 5.7 14.7 L4.7 16 C4.3 16.5 4.7 17.2 5.3 17.2 L18.7 17.2 C19.3 17.2 19.7 16.5 19.3 16 L18.3 14.7 C17.5 13.7 17 12.5 17 11.2 L17 8 C17 5.2 14.8 3 12 3 Z" />
                                    <Path Stroke="White"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M10.2 20 C10.8 20.7 13.2 20.7 13.8 20" />
                                  </Canvas>
                                </Viewbox>
                              </Border>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="Global mode"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <TextBlock Text="Turn off all Windows notifications."
                                           Foreground="#AFC0D4"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </RadioButton.Content>
                      </RadioButton>
                      <RadioButton x:Name="SelectiveFirewallModeRadioButton"
                                   Grid.Column="1"
                                   GroupName="FirewallMode"
                                   Foreground="#E2E8F0"
                                   FontWeight="Bold"
                                   HorizontalContentAlignment="Stretch"
                                   Checked="FirewallModeRadioButton_Checked">
                        <RadioButton.Content>
                          <Border Background="#172033"
                                  BorderBrush="#334155"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Padding="12"
                                  Margin="8,0,0,0">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Border Width="38"
                                      Height="38"
                                      CornerRadius="19"
                                      Background="#0F766E"
                                      Margin="0,0,12,0">
                                <Grid>
                                  <Viewbox Width="20"
                                           Height="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                      <Path Stroke="White"
                                            StrokeThickness="2"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            StrokeLineJoin="Round"
                                            Data="M12 3 C9.2 3 7 5.2 7 8 L7 11.2 C7 12.5 6.5 13.7 5.7 14.7 L4.7 16 C4.3 16.5 4.7 17.2 5.3 17.2 L18.7 17.2 C19.3 17.2 19.7 16.5 19.3 16 L18.3 14.7 C17.5 13.7 17 12.5 17 11.2 L17 8 C17 5.2 14.8 3 12 3 Z" />
                                      <Path Stroke="White"
                                            StrokeThickness="2"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            Data="M10.2 20 C10.8 20.7 13.2 20.7 13.8 20" />
                                    </Canvas>
                                  </Viewbox>
                                  <Border Width="9"
                                          Height="9"
                                          CornerRadius="4.5"
                                          Background="#22C55E"
                                          BorderBrush="White"
                                          BorderThickness="1"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Bottom"
                                          Margin="0,0,8,8" />
                                </Grid>
                              </Border>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="Selective mode"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="Bold" />
                                <TextBlock Text="Silence only selected apps."
                                           Foreground="#AFC0D4"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </RadioButton.Content>
                      </RadioButton>
                    </Grid>
                    <TextBlock x:Name="FirewallModeStatusTextBlock"
                               Text="Global mode is active."
                               Foreground="#AFC0D4"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Selective app targets"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Choose which apps KungFlow should silence when selective mode is active. Only apps that Windows currently exposes as notification senders are shown here."
                               Foreground="#AFC0D4"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="FirewallTargetAvailabilityTextBlock"
                               Text="Checking supported apps..."
                               Foreground="#7DD3FC"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />
                    <StackPanel x:Name="FirewallTargetsPanel"
                                Margin="0,0,0,10" />
                     <TextBlock x:Name="FirewallTargetStatusTextBlock"
                                Foreground="#FACC15"
                                TextWrapping="Wrap"
                                Margin="0,0,0,12" />
                    <Expander IsExpanded="False"
                              Foreground="#CBD5E1"
                              Background="#172033"
                              BorderBrush="#334155"
                              BorderThickness="1"
                              Padding="12"
                              Margin="0,0,0,22">
                      <Expander.Header>
                        <TextBlock Text="Demo tools"
                                   Foreground="#E2E8F0"
                                   FontWeight="Bold" />
                      </Expander.Header>
                      <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Manual controls for validating selective firewall behavior. Normal protection is activated automatically by KungFlow or manually by the main firewall button."
                                   Foreground="#AFC0D4"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="TestSelectiveAppSilenceButton"
                                  Content="Silence selected apps"
                                  Style="{StaticResource SecondaryButton}"
                                  Width="220"
                                  HorizontalAlignment="Left"
                                  Click="TestSelectiveAppSilenceButton_Click" />
                          <Button x:Name="TestSelectiveAppRestoreButton"
                                  Content="Restore selected apps"
                                  Style="{StaticResource SecondaryButton}"
                                  Width="220"
                                  Margin="12,0,0,0"
                                  HorizontalAlignment="Left"
                                  Click="TestSelectiveAppRestoreButton_Click" />
                        </StackPanel>
                      </StackPanel>
                    </Expander>

                    <TextBlock Text="How the firewall protects focus"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,8" />
                    <TextBlock Text="When KungFlow detects red cognitive load, the desktop app activates the firewall using the mode selected above."
                               Foreground="#AFC0D4"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBlock Text="While active, global mode blocks all toast popups, while selective mode tries to silence only selected apps. When load returns to normal, KungFlow restores those notification settings."
                               Foreground="#AFC0D4"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="PrivacyPage"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
          <StackPanel Margin="40,34,40,40">
            <TextBlock Text="PRIVACY POLICY"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#7C8AA2"
                       Margin="0,0,0,8" />
            <TextBlock Text="What KungFlow Stores"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,6" />
            <TextBlock Text="This prototype stores behavioral metadata only, so the team can demonstrate overload detection without collecting typed content."
                       FontSize="14"
                       Foreground="#AFC0D4"
                       TextWrapping="Wrap"
                       Margin="0,0,0,28" />

            <Border Background="#243044" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="20">
              <StackPanel>
                <TextBlock Text="KungFlow stores behavioral metadata used to estimate cognitive load. It does not store typed text content."
                           TextWrapping="Wrap"
                           Foreground="#E2E8F0"
                           Margin="0,0,0,14" />
                <TextBlock Text="Collected desktop metadata includes open window count, active window switches, keypress counts, Delete/Backspace counts, typing rate, mouse movement speed, timestamps, and calculated cognitive load state."
                           TextWrapping="Wrap"
                           Foreground="#E2E8F0"
                           Margin="0,0,0,14" />
                <TextBlock Text="This prototype stores data in the local development database through the KungFlow server. Future versions should include retention controls, export/delete options, and explicit consent screens."
                           TextWrapping="Wrap"
                           Foreground="#E2E8F0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid x:Name="LogoutConfirmationOverlay"
          Visibility="Collapsed"
          Panel.ZIndex="20"
          Background="#B30B1220">
      <Border Width="420"
              Padding="28"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="#1B2638"
              BorderBrush="#334155"
              BorderThickness="1"
              CornerRadius="16">
        <Border.Effect>
          <DropShadowEffect Color="#99000000" BlurRadius="28" ShadowDepth="8" Opacity="0.55" />
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="Log out of KungFlow?"
                     Foreground="White"
                     FontSize="22"
                     FontWeight="Bold"
                     Margin="0,0,0,8" />
          <TextBlock Text="Your current session will end. You can sign back in at any time."
                     Foreground="#AFC0D4"
                     FontSize="13"
                     TextWrapping="Wrap"
                     Margin="0,0,0,24" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Width="100"
                    Click="CancelLogoutButton_Click" />
            <Button Content="Log out"
                    Style="{StaticResource PrimaryButton}"
                    Background="#DC2626"
                    Width="100"
                    Margin="10,0,0,0"
                    Click="ConfirmLogoutButton_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
